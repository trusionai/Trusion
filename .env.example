# PLACEHOLDERS ONLY. Never commit real values. Backend reads real environment variables (no dotenv loader is bundled);
# the frontend build reads TRUSION_* variables from the build environment.

# ---------------- backend (see backend/.env.example for details) ----------------
JWT_MODE=jwks                       # "jwks" (asymmetric, preferred) or "hs256" (explicit shared secret). Required: the server refuses to start without it.
JWKS_URL=https://REPLACE_WITH_YOUR_AUTH_PROVIDER_JWKS_URL
JWT_ISSUER=https://REPLACE_WITH_YOUR_ISSUER
JWT_AUDIENCE=authenticated
# SUPABASE_JWT_SECRET=              # only for JWT_MODE=hs256; >= 32 chars; SERVER ONLY
ADMIN_USER_IDS=                     # comma-separated auth subject ids allowed on /v1/admin/*; empty = nobody
CORS_ORIGINS=https://REPLACE_WITH_FRONTEND_ORIGIN
DB_PATH=./data/trusion.db           # SQLite = LOCAL/TEST ONLY. Production storage is NOT implemented (see docs/PRODUCTION-READINESS.md)
# MODELS_CONFIG=./config/models.json
# AI_PROVIDERS=[{"name":"example","baseUrl":"https://REPLACE_WITH_VERIFIED_BASE_URL/v1","apiKeyEnv":"EXAMPLE_API_KEY"}]
# EXAMPLE_API_KEY=                  # server-side secret, never in the frontend

# ---------------- frontend build (PUBLIC values only) ----------------
TRUSION_API_BASE_URL=https://REPLACE_WITH_API_ORIGIN
TRUSION_AUTH_URL=https://REPLACE_WITH_PROJECT.example/auth/v1
TRUSION_AUTH_PUBLIC_KEY=REPLACE_WITH_PUBLIC_ANON_KEY   # the PUBLIC/anon key only. The build refuses service-role keys. It identifies the project; it is not authorization.
# TRUSION_ALLOW_INSECURE_DEV=1      # allows http://localhost URLs for local development ONLY

# Isolation + retention (optional; strict integers; defaults shown). Retention days are PROVISIONAL: set them from your privacy policy.
# APK_MAX_CONCURRENT=2
# APK_MAX_QUEUE=8
# APK_TIMEOUT_MS=10000
# APK_MEMORY_MB=256
# RETENTION_ANALYSIS_DAYS=90
# RETENTION_ATTEMPT_DAYS=400
