{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitReturns": true, "noFallthroughCasesInSwitch": true, "noImplicitOverride": true, "noEmit": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true, "types": [], "lib": ["ES2023", "DOM"], "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "typecheck-shim.d.ts"]
}
